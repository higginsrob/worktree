#!/usr/bin/env bash
# Prompts to kill the whole tmux session on two Ctrl-C presses within 1
# second. Bound from tmux.conf as:
#   bind-key -n C-c send-keys C-c \; run-shell -b "wkt-doublec-check '#{session_name}'"
# so the first C-c still interrupts whatever's running in the pane as normal;
# this just watches for a fast second press. The same statefile is also read
# by wkt-detach-check, so a fast Ctrl-C then Ctrl-D detaches instead.
set -u

session="${1:?session name required}"
statefile="/tmp/.wkt-doublec-${session}"
# GNU date has %3N; BSD/macOS date doesn't (it prints a literal trailing "N"),
# so fall back to perl (ships with macOS), then to whole seconds.
now_ms=$(date +%s%3N)
case "$now_ms" in '' | *[!0-9]*)
  now_ms=$(perl -MTime::HiRes=time -e 'printf "%d", time * 1000' 2>/dev/null)
  case "$now_ms" in '' | *[!0-9]*) now_ms=$(($(date +%s) * 1000)) ;; esac
  ;;
esac

last_ms=0
[ -r "$statefile" ] && read -r last_ms < "$statefile"
case "$last_ms" in '' | *[!0-9]*) last_ms=0 ;; esac

if [ -z "$now_ms" ]; then
  :
elif [ $((now_ms - last_ms)) -lt 1000 ]; then
  rm -f "$statefile"
  tmux confirm-before -p "Kill session ${session}? (y/n)" "kill-session -t =${session}"
else
  echo "$now_ms" > "$statefile"
fi
