#!/usr/bin/env bash
# Renders the tmux statusline GIT badge: branch name, colored by
# clean/dirty/ahead/behind/diverged. Read-only — no push/pull/sync actions
# live here (those are host-only `wkt` commands).
set -u

FG_DARK="#1a1b26"

# $WKT_WORKSPACE_DIR is set by the host CLI for both sandbox containers and
# host tmux sessions; the /workspace glob is a fallback for older images.
# Statusline #() jobs run with the tmux server's env, shared by every session,
# so prefer the session's own value (session name passed as $1).
repo_dir=""
if [ -n "${1:-}" ]; then
  repo_dir=$(tmux show-environment -t "$1" WKT_WORKSPACE_DIR 2>/dev/null | sed -n 's/^WKT_WORKSPACE_DIR=//p')
fi
repo_dir="${repo_dir:-${WKT_WORKSPACE_DIR:-$(printf '%s\n' /workspace/*/ 2>/dev/null | head -n1)}}"
if [ -z "$repo_dir" ] || ! git -C "$repo_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "#[fg=${FG_DARK},bg=#565f89,bold] no-repo #[default]"
  exit 0
fi

branch=$(git -C "$repo_dir" symbolic-ref --short HEAD 2>/dev/null)
if [ -z "$branch" ]; then
  branch=$(git -C "$repo_dir" rev-parse --short HEAD 2>/dev/null)
fi

dirty=""
[ -n "$(git -C "$repo_dir" status --porcelain 2>/dev/null)" ] && dirty=1

ahead=0
behind=0
if git -C "$repo_dir" rev-parse --verify --quiet '@{u}' >/dev/null 2>&1; then
  read -r ahead behind < <(git -C "$repo_dir" rev-list --left-right --count 'HEAD...@{u}' 2>/dev/null)
fi

if [ -n "$dirty" ] && { [ "$ahead" != "0" ] || [ "$behind" != "0" ]; }; then
  color="#f7768e" # red: dirty + diverged
elif [ -n "$dirty" ]; then
  color="#f7768e" # red: dirty
elif [ "$ahead" != "0" ] && [ "$behind" != "0" ]; then
  color="#bb9af7" # magenta: diverged
elif [ "$ahead" != "0" ]; then
  color="#7dcfff" # cyan: ahead
elif [ "$behind" != "0" ]; then
  color="#e0af68" # yellow: behind
else
  color="#9ece6a" # green: clean
fi

echo "#[fg=${FG_DARK},bg=${color},bold] ${branch} #[default]"
