#!/usr/bin/env bash
# Dispatches a tmux statusline badge click. Bound from tmux.conf as:
#   run-shell -b "wkt-status-click <range> <pane_path> <session> <client> <pane_w> <pane_h>"
# so every argument is already resolved by tmux before this script runs.
set -u

# tmux >= 3.2 expands #{mouse_status_range} to just the argument after
# "range=user|" (e.g. "new-window"), not "user|new-window".
range="${1#user|}"
pane_path="${2:-}"
session="${3:-}"
client="${4:-}"
pane_w="${5:-0}"
pane_h="${6:-0}"

case "$range" in
  new-window)
    tmux new-window -c "$pane_path"
    ;;
  split-h)
    tmux split-window -h -c "$pane_path"
    ;;
  split-v)
    tmux split-window -v -c "$pane_path"
    ;;
  workspace)
    wkt-workspace-menu "$session" "$client"
    ;;
  git-status)
    repo_dir=$(tmux show-environment -t "$session" WKT_WORKSPACE_DIR 2>/dev/null | sed -n 's/^WKT_WORKSPACE_DIR=//p')
    repo_dir="${repo_dir:-${WKT_WORKSPACE_DIR:-$(printf '%s\n' /workspace/*/ 2>/dev/null | head -n1)}}"
    wkt-git-menu "$repo_dir" "$client" "$pane_w" "$pane_h"
    ;;
esac
