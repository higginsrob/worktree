" wkt vim config (system-wide: /etc/vim/vimrc.local).

syntax on
filetype plugin indent on

set nocompatible
set number
set relativenumber
set expandtab
set shiftwidth=2
set tabstop=2
set softtabstop=2
set autoindent
set smartindent
set incsearch
set hlsearch
set ignorecase
set smartcase
set mouse=a
set scrolloff=4
set wildmenu
set laststatus=2
set backspace=indent,eol,start
set updatetime=300

" vim-fugitive is bundled at build time — :Git, :Gdiffsplit, etc.

" OSC 52 clipboard passthrough: yanks reach the host terminal's real
" clipboard over the docker exec -it PTY, same mechanism as tmux copy-mode.
if has('autocmd')
  augroup wkt_osc52_yank
    autocmd!
    autocmd TextYankPost * if v:event.operator ==# 'y' | call system('osc52-copy', getreg(v:event.regname)) | endif
  augroup END
endif
