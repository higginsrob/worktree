{
  "name": "@higginsrob/worktree",
  "version": "0.1.0",
  "description": "git worktree sessions with a consistent tmux+vim environment, on the host by default or sandboxed in Docker.",
  "type": "module",
  "license": "MIT",
  "author": "Rob Higgins",
  "homepage": "https://github.com/higginsrob/worktree#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/higginsrob/worktree.git"
  },
  "bugs": {
    "url": "https://github.com/higginsrob/worktree/issues"
  },
  "keywords": [
    "git",
    "git-worktree",
    "docker",
    "devcontainer",
    "tmux",
    "sandbox"
  ],
  "bin": {
    "wkt": "bin/wkt"
  },
  "files": [
    "bin",
    "dist",
    "docker"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
